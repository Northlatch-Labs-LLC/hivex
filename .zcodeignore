# VHS visual regression artifacts — only .txt goldens are diffed;
# .gif output and .actual drift files regenerate on every run of
# testdata/vhs/check.sh and are not tracked in git.
testdata/vhs/*.gif
testdata/vhs/*.actual

# Web test coverage output
web/coverage/

# Workspace package build/coverage output
packages/*/dist/
packages/*/coverage/
packages/*/.tsbuildinfo
packages/*/tsconfig.tsbuildinfo

# Dev build artifacts
hivex-dev


# Local dev binary built by scripts/debug-tagging/run.sh
/.hivex-debug-tagging

# goreleaser / cross-compile output (scripts/win-vm/build.sh, etc.)
/dist/

# Windows VM harness build artifacts (ISO/IMG regenerated by make-answer-disk.sh)
/scripts/win-vm/autounattend.img
/scripts/win-vm/autounattend.iso
/scripts/win-vm/answer.cdr
/scripts/win-vm/answer-src/Drivers/

# Desktop release artifacts (built/signed locally; CI uploads to Releases)
/dist-desktop/
/desktop/oswails/dist/

# Operator orchestration spikes (LangGraph/deepagents/Inngest) — scratch only, not adopted
/orchestrator/
/spikes/
runner/__pycache__/

# Local test-instance logs (see hivebot-testdrive.log)
hivebot-testdrive.log

# Composio CLI state the integration tests drop into the source tree.
# `go test ./internal/team/` shells out to the Composio CLI, which writes its
# config/session next to the package instead of into a temp HOME. One of these
# (pending-login-session.json) holds a login session key, so leaving them
# untracked-but-not-ignored put a secret one `git add -A` away from a commit.
# Ignoring is the guard; the tests should get an isolated HOME as a follow-up.
/internal/team/config.json
/internal/team/pending-login-session.json
/internal/team/user_data.json

